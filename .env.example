# Postgres. Прод — pooled-строка из Neon, локально — обычный Postgres.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# openssl rand -hex 32
AUTH_SECRET=

# Токен Apify (Settings -> API & Integrations). Без него сайт работает на демо-данных.
APIFY_TOKEN=

# Ключ для одноразового вызова /api/setup
SETUP_KEY=

# Первый администратор — создаётся при вызове /api/setup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Код приглашения для самостоятельной регистрации блогеров
INVITE_CODE=

# Секрет для Vercel Cron (ежедневное обновление метрик)
CRON_SECRET=
